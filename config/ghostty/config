# =============================================================================
# Ghostty config — shawn (cross-platform)
# =============================================================================
# Docs:    https://ghostty.org/docs/config
# Reload:  Cmd+Shift+,  (or close + reopen Ghostty)
# Themes:  run `ghostty +list-themes` to browse built-ins
#
# This file holds CROSS-PLATFORM settings. OS-specific options live in os.conf
# (which install.sh symlinks to os-macos.conf or os-linux.conf per machine).
# =============================================================================



# ---- Font --------------------------------------------------------------------
# Match nvim's font so Nerd Font glyphs (neo-tree, which-key, lualine) render
# consistently across the terminal and the editor.
font-family = JetBrainsMono Nerd Font
font-size = 14



# ---- Theme -------------------------------------------------------------------
# Match nvim's colorscheme. If `TokyoNight Night` isn't recognized, run
# `ghostty +list-themes` and pick the closest variant.
theme = "TokyoNight Night"



# ---- Background wallpaper ----------------------------------------------------
# Subtle/faded look. background-image-opacity 0.0 = invisible, 1.0 = full.
# 0.15 = subtle (code reads cleanly over it).
# Path uses ~ so it works on both /Users/<u>/ (macOS) and /home/<u>/ (Linux).
background-image = ~/Pictures/wallpapers/tokyo_neon.jpg
background-image-opacity = 0.15
background-image-position = center
background-image-fit = cover

# Keep terminal background fully opaque — wallpaper IS the visual; we don't
# want macOS desktop / Windows desktop bleeding through on top of that.
background-opacity = 1.0



# ---- Window appearance -------------------------------------------------------
window-padding-x = 10
window-padding-y = 10
window-decoration = true
# Restore size/position when reopening.
window-save-state = always



# ---- Cursor ------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false



# ---- Mouse -------------------------------------------------------------------
mouse-hide-while-typing = true



# ---- OS-specific overrides (symlinked per machine by install.sh) -------------
# os.conf -> os-macos.conf  on macOS    (adds macos-option-as-alt)
# os.conf -> os-linux.conf  on Linux    (currently empty placeholder)
config-file = os.conf
